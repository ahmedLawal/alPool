{
  "name": "alpool",
  "version": "1.19.0",
  "description": "alPool multi-account Claude Code proxy with adaptive, rate-aware load balancing",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "alpool": "src/index.js"
  },
  "files": [
    "src/",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/index.js",
    "test": "bash scripts/run-tests.sh",
    "lint": "eslint src/ test/",
    "sync:upstream": "bash scripts/sync-upstream.sh",
    "sync:install": "bash scripts/install-local-sync.sh",
    "macos:test": "swift test --package-path macos",
    "macos:build": "bash scripts/build-macos-app.sh",
    "macos:install-backend": "bash scripts/install-backend-agent.sh",
    "release": "bash scripts/release.sh",
    "version": "bash scripts/update-changelog.sh"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "proxy",
    "load-balancer",
    "rate-limit",
    "multi-account"
  ],
  "author": "Max Krasnykh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmedLawal/alPool.git"
  },
  "homepage": "https://github.com/ahmedLawal/alPool#readme",
  "bugs": {
    "url": "https://github.com/ahmedLawal/alPool/issues"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "git-cliff": "2.13.1"
  }
}
